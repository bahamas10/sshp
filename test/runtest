. ./lib/helpers || exit 1

# loop arguments and run them
ret=0
for f in "$@"; do
	[[ ${f:0:1} == '/' ]] || f=./$f

	echo "${bld}running:$rst  $f"

	if ! "$f"; then
		ret=1
		echo
		echo "${red}error:  $f"
		echo
	fi

	echo
done

if ((ret == 0)); then
	echo "all tests passed ${grn}succesfully${rst}"
else
	echo "${red}errors detected${rst}"
fi

exit "$ret"
