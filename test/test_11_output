. ./lib/helpers || exit 1

singlehost=./assets/hosts/single-host.txt

mkdir -p tmp
tmp=./tmp/output.$$
normalized=./tmp/normalized.$$

cleanup() {
	rm -f "$normalized" "$tmp"
}
trap cleanup EXIT

# silent mode should discard both child output streams.
verify-sshp-output 0 "$singlehost" /dev/null \
    -a -s -x ./assets/cmd/stdio-output arg

# trimming should affect the displayed label but not the destination passed to
# the child.
verify-sshp-output 0 ./assets/hosts/trim-host.txt \
    ./assets/output/trim-output.txt \
    -t -x ./assets/cmd/print-destination arg

# the output generated by `sshp -e` contains the time taken in ms - we normalize
# that output to remove any sort of timing issues in the test
verify-exit-output() {
	local want=$1
	local fixture=$2
	local expected=$3

	local code
	cmd=("$SSHP" -c off -e -x "$fixture" arg)
	"${cmd[@]}" < "$singlehost" > "$tmp" 2>&1
	code=$?

	verify-equal "$want" "$code" "${cmd[*]} code"

	awk '{
		sub(/\([0-9][0-9]* ms\)$/, "(TIME ms)");
		print;
	}' "$tmp" > "$normalized"
	verify-files-equal "$expected" "$normalized" "${cmd[*]} output"
}

verify-exit-output 0 ./assets/cmd/true ./assets/output/exit-success.txt
verify-exit-output 1 ./assets/cmd/false ./assets/output/exit-failure.txt

exit 0
